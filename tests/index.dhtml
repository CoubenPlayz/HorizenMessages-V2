import random

def play_game():
    print("Welcome to Rock, Paper, Scissors!")
    print("Rules: 1 = Rock, 2 = Paper, 3 = Scissors")
    
    # Map numbers to strings for readable results
    choices = {1: "Rock", 2: "Paper", 3: "Scissors"}
    
    # Get user choice
    try:
        user_choice = int(input("Enter your choice (1, 2, or 3): "))
        if user_choice not in [1, 2, 3]:
            print("Invalid selection. Please run the game again and choose 1, 2, or 3.")
            return
    except ValueError:
        print("Invalid input. Please enter a number.")
        return

    # Generate computer choice using random.randint(1, 3)
    computer_choice = random.randint(1, 3)
    
    print(f"\nYou chose: {choices[user_choice]}")
    print(f"Computer chose: {choices[computer_choice]}\n")
    
    # Determine the winner
    if user_choice == computer_choice:
        print("It's a tie!")
    elif (user_choice == 1 and computer_choice == 3) or \
         (user_choice == 2 and computer_choice == 1) or \
         (user_choice == 3 and computer_choice == 2):
        print("You win!")
    else:
        print("Computer wins!")

# Run the game
play_game()
